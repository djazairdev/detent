{
  "name": "detent",
  "version": "3.2.1",
  "private": true,
  "description": "Turns planning documents into merged, reviewed, test-gated code with Claude Code, under a deterministic referee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djazairdev/detent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "parity": "tsx scripts/parity.ts",
    "parity:check": "tsx scripts/parity.ts --check",
    "prompts": "tsx scripts/hash-prompts.ts",
    "prompts:check": "tsx scripts/hash-prompts.ts --check",
    "plugin": "tsx scripts/build-plugin.ts",
    "plugin:validate": "claude plugin validate --strict . && claude plugin validate --strict .claude-plugin/plugin.json && claude plugin validate --strict skills && claude plugin validate --strict agents",
    "rules:check": "tsx scripts/check-rules.ts",
    "eval:build": "tsx scripts/eval-build.ts",
    "eval:run": "tsx scripts/eval-run.ts",
    "eval:score": "tsx scripts/eval-score.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@modelcontextprotocol/sdk": "1.32.1",
    "picomatch": "4.0.5",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.3"
  }
}
