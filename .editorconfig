# Editors read this so every contributor gets the same basics (editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,php,rs}]
indent_size = 4

[{*.go,Makefile,go.mod}]
indent_style = tab

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
